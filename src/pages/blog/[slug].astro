---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Articulo from '@/layouts/Articulo.astro';
import { articulosPublicados, relacionados, type Articulo as TipoArticulo } from '@/lib/blog';
import { textoPlano } from '@/lib/blog-utilidades';

export const getStaticPaths = (async () => {
  const todos = await articulosPublicados();
  return todos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo, relacionados: relacionados(articulo, todos) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  articulo: TipoArticulo;
  relacionados: TipoArticulo[];
}

const { articulo, relacionados: otros } = Astro.props;
const { Content } = await render(articulo);
// Mientras no se migre el texto, el cuerpo solo tiene el comentario «PENDIENTE»
const tieneTexto = textoPlano(articulo.body ?? '').length > 0;
---

<Articulo articulo={articulo} relacionados={otros}>
  {tieneTexto ? (
    <Content />
  ) : (
    <div class="card pendiente" role="note">
      <div class="label">Pendiente · migración</div>
      <p class="body">Texto del artículo pendiente de migrar desde la web actual.</p>
    </div>
  )}
</Articulo>
