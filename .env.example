# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de estudioseijo.com
# Copia este archivo como `.env` y rellena los valores. `.env` NUNCA se sube al repositorio.
# En producción, estas variables se configuran en el panel del hosting.
# Las variables con prefijo PUBLIC_ se incluyen en el código que llega al navegador: no pongas secretos en ellas.
# ─────────────────────────────────────────────────────────────────────────────

# ── Reservas · Google Calendar (fase 4) ── PENDIENTE: tipo de cuenta y credenciales
# Sin credenciales, la reserva funciona en modo provisional (huecos según reglas y envío por WhatsApp/email).
# Pasos para conseguirlas: README → «Conectar Google Calendar».
# Calendario donde se consultan huecos y se crean las reuniones (p. ej. info@estudioseijo.com).
GOOGLE_CALENDAR_ID=
# Opción A · Google Workspace: cuenta de servicio con delegación de dominio.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio (en una línea, con los saltos de línea escritos como \n).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Usuario de Workspace en cuyo nombre actúa la cuenta de servicio.
GOOGLE_IMPERSONATE_USER=
# Opción B · Gmail personal: OAuth con refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Plan B: enlace de la agenda de citas de Google. Si se rellena, la web muestra esa agenda en lugar del
# calendario propio. Se lee al construir el sitio (hay que volver a hacer `pnpm build`). PENDIENTE
PUBLIC_GOOGLE_BOOKING_URL=

# Reservas por IP cada 10 minutos (límite anti-abuso).
RESERVAS_LIMITE_POR_IP=5

# ── Anti-spam · Cloudflare Turnstile (fases 4 y 5) ── PENDIENTE
# Muy recomendable en producción. Sin clave secreta, el servidor no lo exige.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Correo transaccional (fases 4 y 5) ── PENDIENTE: servicio (Resend, SMTP…) y remitente
MAIL_FROM=
# Dirección que recibe los avisos internos de nuevas reservas.
MAIL_AVISOS=info@estudioseijo.com
RESEND_API_KEY=
# Alternativa SMTP (se usa si no hay RESEND_API_KEY)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Analítica (fase 6) ── PENDIENTE: ID de GA4 (formato G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# ── Pruebas (no usar en producción) ──
# URL de un Google Calendar simulado (las pruebas e2e usan tests/e2e/google-simulado.mjs).
GOOGLE_API_URL=
GOOGLE_TOKEN_URL=
# «Ahora» fijo para el servidor (ISO 8601). Solo se respeta si GOOGLE_API_URL está definido.
PRUEBAS_AHORA=
# Ruta a un Chromium ya instalado, si no se usan los navegadores que descarga Playwright.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
