---
import type { GetStaticPaths } from 'astro';
import ListadoBlog from '@/components/blog/ListadoBlog.astro';
import Pagina from '@/layouts/Pagina.astro';
import { categorias, type Categoria } from '@/config/blog';
import { articulosPublicados } from '@/lib/blog';

export const getStaticPaths = (() =>
  categorias.map((categoria) => ({
    params: { cat: categoria.slug },
    props: { categoria },
  }))) satisfies GetStaticPaths;

interface Props {
  categoria: Categoria;
}

const { categoria } = Astro.props;
const articulos = (await articulosPublicados()).filter((a) => a.data.categoria === categoria.nombre);
---

<Pagina
  titulo={`${categoria.nombre} · Blog`}
  titular={categoria.nombre}
  etiqueta="Noticias y blog"
  entradilla="Web, captación, datos, normativa, automatización y software de gestión, explicados de forma práctica y sin tecnicismos."
  descripcion={`Artículos de ${categoria.nombre.toLowerCase()} para pymes, explicados de forma práctica.`}
>
  <ListadoBlog articulos={articulos} activa={categoria} />
</Pagina>
