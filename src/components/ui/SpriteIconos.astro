---
/**
 * Sprite de iconos de línea (trazo 1,8) extraído de la maqueta.
 * Se incluye una vez por página en el layout base; los iconos se usan con <Icono nombre="…" />.
 * Para añadir un icono: nuevo <symbol id="i-nombre" viewBox="0 0 28 28"> y su nombre en `NombreIcono`.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-search" viewBox="0 0 28 28">
    <circle cx="12" cy="12" r="7.5" />
    <line x1="17.5" y1="17.5" x2="24" y2="24" />
  </symbol>
  <symbol id="i-repeat" viewBox="0 0 28 28">
    <path d="M5 12 a9 9 0 0 1 16 -4 L23 10" />
    <polyline points="23,4.5 23,10 17.5,10" />
    <path d="M23 16 a9 9 0 0 1 -16 4 L5 18" />
    <polyline points="5,23.5 5,18 10.5,18" />
  </symbol>
  <symbol id="i-clock" viewBox="0 0 28 28">
    <circle cx="14" cy="14" r="10" />
    <polyline points="14,8 14,14 18,16.5" />
  </symbol>
  <symbol id="i-monitor" viewBox="0 0 28 28">
    <rect x="3.5" y="5" width="21" height="14" rx="2" />
    <line x1="14" y1="19" x2="14" y2="23.5" />
    <line x1="9.5" y1="23.5" x2="18.5" y2="23.5" />
  </symbol>
  <symbol id="i-sheet" viewBox="0 0 28 28">
    <rect x="4.5" y="4" width="19" height="20" rx="2" />
    <line x1="4.5" y1="10" x2="23.5" y2="10" />
    <line x1="4.5" y1="16" x2="23.5" y2="16" />
    <line x1="11" y1="4" x2="11" y2="24" />
  </symbol>
  <symbol id="i-question" viewBox="0 0 28 28">
    <circle cx="14" cy="14" r="10" />
    <path d="M10.8 11 a3.3 3.3 0 1 1 4.6 3 C14.4 14.6 14 15.3 14 16.5" />
    <circle cx="14" cy="20" r=".6" />
  </symbol>
  <symbol id="i-link" viewBox="0 0 28 28">
    <path d="M12 16 a4.5 4.5 0 0 0 6.4 0 l3.6 -3.6 a4.5 4.5 0 0 0 -6.4 -6.4 l-1.6 1.6" />
    <path d="M16 12 a4.5 4.5 0 0 0 -6.4 0 l-3.6 3.6 a4.5 4.5 0 0 0 6.4 6.4 l1.6 -1.6" />
  </symbol>
  <symbol id="i-bulb" viewBox="0 0 28 28">
    <path d="M10 19 C10 16 7 14.5 7 10.5 a7 7 0 0 1 14 0 C21 14.5 18 16 18 19 Z" />
    <line x1="10.5" y1="22" x2="17.5" y2="22" />
    <line x1="11.5" y1="25" x2="16.5" y2="25" />
  </symbol>
  <symbol id="i-dots" viewBox="0 0 28 28">
    <circle cx="7" cy="14" r="1.3" />
    <circle cx="14" cy="14" r="1.3" />
    <circle cx="21" cy="14" r="1.3" />
  </symbol>
  <symbol id="i-check" viewBox="0 0 28 28">
    <polyline points="6,14.5 11.5,20 22,8.5" />
  </symbol>
  <symbol id="i-phone" viewBox="0 0 28 28">
    <path d="M7 4 H11 L13 9.5 L10.5 11 a12 12 0 0 0 6.5 6.5 L18.5 15 L24 17 V21 a2 2 0 0 1 -2 2 A18 18 0 0 1 5 6 a2 2 0 0 1 2 -2 Z" />
  </symbol>
  <symbol id="i-chat" viewBox="0 0 28 28">
    <path d="M5 7 a3 3 0 0 1 3 -3 H20 a3 3 0 0 1 3 3 V15.5 a3 3 0 0 1 -3 3 H12.5 L7.5 23.5 V18.5 a3 3 0 0 1 -2.5 -3 Z" />
    <line x1="10" y1="9.5" x2="18" y2="9.5" />
    <line x1="10" y1="13.5" x2="15" y2="13.5" />
  </symbol>
  <symbol id="i-mail" viewBox="0 0 28 28">
    <rect x="3.5" y="6" width="21" height="16" rx="2" />
    <polyline points="4,7 14,15 24,7" />
  </symbol>
  <symbol id="i-pin" viewBox="0 0 28 28">
    <path d="M14 25 C14 25 6 17 6 11.5 a8 8 0 0 1 16 0 C22 17 14 25 14 25 Z" />
    <circle cx="14" cy="11.5" r="3" />
  </symbol>
  <symbol id="i-calendar" viewBox="0 0 28 28">
    <rect x="4" y="6" width="20" height="18" rx="2" />
    <line x1="4" y1="11" x2="24" y2="11" />
    <line x1="9.5" y1="3.5" x2="9.5" y2="8" />
    <line x1="18.5" y1="3.5" x2="18.5" y2="8" />
  </symbol>
  <symbol id="i-people" viewBox="0 0 28 28">
    <circle cx="14" cy="9" r="3.6" />
    <path d="M7.5 22 a6.5 6.5 0 0 1 13 0" />
    <circle cx="6" cy="11" r="2.6" />
    <circle cx="22" cy="11" r="2.6" />
  </symbol>
  <symbol id="i-bars" viewBox="0 0 28 28">
    <rect x="4" y="15" width="4.5" height="9" rx="1" />
    <rect x="11.75" y="9" width="4.5" height="15" rx="1" />
    <rect x="19.5" y="4" width="4.5" height="20" rx="1" />
  </symbol>
  <symbol id="i-stack" viewBox="0 0 28 28">
    <rect x="4" y="9" width="15" height="15" rx="2" />
    <path d="M9 9 V6 a2 2 0 0 1 2 -2 H22 a2 2 0 0 1 2 2 V17 a2 2 0 0 1 -2 2 H19" />
  </symbol>
  <symbol id="i-gear" viewBox="0 0 28 28">
    <circle cx="14" cy="14" r="4" />
    <path d="M14 3 V6 M14 22 V25 M3 14 H6 M22 14 H25 M6.2 6.2 L8.3 8.3 M19.7 19.7 L21.8 21.8 M6.2 21.8 L8.3 19.7 M19.7 8.3 L21.8 6.2" />
  </symbol>
  <symbol id="i-share" viewBox="0 0 28 28">
    <circle cx="7" cy="14" r="3.2" />
    <circle cx="21" cy="7" r="3.2" />
    <circle cx="21" cy="21" r="3.2" />
    <line x1="9.9" y1="12.5" x2="18.1" y2="8.5" />
    <line x1="9.9" y1="15.5" x2="18.1" y2="19.5" />
  </symbol>
  <symbol id="i-shield" viewBox="0 0 28 28">
    <path d="M14 3.5 L23 7 V13.5 C23 19 19 23 14 24.5 C9 23 5 19 5 13.5 V7 Z" />
    <polyline points="10,14 13,17 18.5,11" />
  </symbol>
  <symbol id="i-box" viewBox="0 0 28 28">
    <path d="M14 3.5 L24 8.5 V19.5 L14 24.5 L4 19.5 V8.5 Z" />
    <polyline points="4,8.5 14,13.5 24,8.5" />
    <line x1="14" y1="13.5" x2="14" y2="24.5" />
  </symbol>
  <symbol id="i-arrow-l" viewBox="0 0 28 28">
    <line x1="22" y1="14" x2="6" y2="14" />
    <polyline points="12,8 6,14 12,20" />
  </symbol>
  <symbol id="i-arrow-r" viewBox="0 0 28 28">
    <line x1="6" y1="14" x2="22" y2="14" />
    <polyline points="16,8 22,14 16,20" />
  </symbol>
  <symbol id="i-star" viewBox="0 0 28 28">
    <polygon points="14,3.5 17.2,10.3 24.5,11.1 19,16.1 20.6,23.4 14,19.6 7.4,23.4 9,16.1 3.5,11.1 10.8,10.3" />
  </symbol>
  <symbol id="i-video" viewBox="0 0 28 28">
    <rect x="3.5" y="8" width="15" height="12" rx="2" />
    <path d="M18.5 12.5 L24.5 9 V19 L18.5 15.5 Z" />
  </symbol>
  <symbol id="i-menu" viewBox="0 0 28 28">
    <line x1="5" y1="9" x2="23" y2="9" />
    <line x1="5" y1="14" x2="23" y2="14" />
    <line x1="5" y1="19" x2="23" y2="19" />
  </symbol>
</svg>
